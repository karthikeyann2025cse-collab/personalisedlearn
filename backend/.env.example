# ─── Application ──────────────────────────────────────────────
APP_NAME=LearnOn
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Database ─────────────────────────────────────────────────
# SQLite (default for local dev — no install needed)
DATABASE_URL=sqlite+aiosqlite:///./learnon.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/learnon

# ─── AI / LLM ─────────────────────────────────────────────────
# OpenAI-compatible endpoint — works with OpenAI, Azure OpenAI, LM Studio, Ollama, etc.
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ─── PDF / Upload ─────────────────────────────────────────────
UPLOAD_DIR=../uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf

# ─── Vector Store ─────────────────────────────────────────────
VECTOR_STORE_PATH=./vectorstore
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ─── ML ───────────────────────────────────────────────────────
ML_MODELS_PATH=./ml_models

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
